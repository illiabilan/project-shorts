# =====================================================================
# OpenShorts + Autonomous System Environment Configuration
# =====================================================================

# 1. AI Model Providers (Google AI Studio, OpenRouter, Fireworks, Anthropic, OpenAI, Groq, Ollama)
# - gemini: Google Gemini API (https://aistudio.google.com/)
# - openrouter: OpenRouter (https://openrouter.ai/keys)
# - fireworks: Fireworks AI (https://fireworks.ai/api-keys)
# - anthropic: Anthropic Claude (https://console.anthropic.com/)
# - openai: OpenAI (https://platform.openai.com/api-keys)
# - groq: Groq (https://console.groq.com/keys)
# - ollama: Local Ollama (http://localhost:11434/v1)
# - custom: Custom OpenAI-compatible server
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=

# Legacy / Direct Gemini Key (if using gemini provider or for layout picking)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_THUMBNAIL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# FFmpeg Encoder:
# - x264: Universal CPU encoding (Mac / Linux)
# - vaapi: AMD Radeon GPU hardware acceleration (e.g. RX 7800 XT)
# - nvenc: NVIDIA GPU hardware acceleration
FFMPEG_ENCODER=x264

# Whisper ASR model for transcription (base/small for lightweight CPU, large-v3-turbo for GPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Rate limits & Server
RATE_LIMIT_ENABLED=0
OPENSHORTS_API_URL=http://localhost:8000

# 3. Autonomous Scheduler & Web Dashboard Configuration
WEB_UI_PORT=8080
RUN_SCHEDULER_WITH_WEB_UI=true
QUEUE_FILE=queue.json
OUTPUT_DIR=processed_shorts
POLL_INTERVAL_SEC=30
JOB_CHECK_INTERVAL_SEC=10

# 4. Social Media Auto-Posting (YouTube Shorts Data API v3)
# Place client_secrets.json in credentials/ folder
AUTO_POST=false
AUTO_POST_INTERVAL_HOURS=3.0
YOUTUBE_CLIENT_SECRETS=credentials/client_secrets.json
YOUTUBE_TOKEN_FILE=credentials/token.json

# 5. Hook Intro Card (Freeze-frame first frame with blur & title)
# AUTO_HOOK: 1 to enable, 0 to disable
# AUTO_HOOK_MODE: 'intro' (freeze-frame card) or 'overlay' (text on video)
# AUTO_HOOK_SECONDS: duration of intro card in seconds (e.g. 1.8)
# AUTO_HOOK_STYLE: 'classic', 'dark', 'yellow', 'red', 'outline', 'outline_yellow'
AUTO_HOOK=1
AUTO_HOOK_MODE=intro
AUTO_HOOK_SECONDS=1.8
AUTO_HOOK_STYLE=classic
